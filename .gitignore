#   E:/_dx/_Games/MC/xxxxxx/.minecraft/versions/Botanical-Magic-Art/
# 部署脚本：scripts/deploy.ps1
# ============================================================

# --- 运行时不入库 ---
/mods/
/logs/
/backups/
/exports/
/.cache/
/.mejs/
/.vscode/
/modernfix/
/XaeroWaypoints_BACKUP*/
/local/
/TrashSlotSaveState.json
/modernfix/
/enigmatic_persistence.dat
/observable_announce
/options.txt
/rhino.local.properties
/Botanical-Magic-Art.jar
/Botanical-Magic-Art.json
/Botanical-Magic-Art-natives/
/PCL/

